rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Isolated user files: users/{userId}/...
    // Allows each authenticated user to read, write, and manage only their own profile and case images
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
