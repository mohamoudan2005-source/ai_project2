rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny: No unauthorized global collections or wildcard access
    match /{document=**} {
      allow read, write: if false;
    }

    // User-isolated partition: Each user can ONLY access their own document
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      // User-specific cases subcollection: users/{userId}/cases/{caseId}
      match /cases/{caseId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // Legacy history subcollection access restricted to the user themselves
      match /history/{historyId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }
    }
  }
}
